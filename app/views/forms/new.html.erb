<h1>Create Form</h1>
<%= form_with url: forms_path, local: true do %>
  <p>
    <label for="name">Name</label>
    <%= text_field_tag "form[name]", nil, id: "name" %>
  </p>

  <p>
    <label for="field_label_1">Field 1 label</label>
    <%= text_field_tag "form[structure][fields][][label]", nil, id: "field_label_1" %>
  </p>

  <p>
    <%= submit_tag "Create" %>
    <%= link_to "Cancel", "/forms" %>
  </p>
<% end %>
