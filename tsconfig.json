{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "resolveJsonModule": true,
    /**
     * Typecheck JS in `.svelte` and `.js` files by default.
     * Disable checkJs if you'd like to use dynamic types in JS.
     * Note that setting allowJs false does not prevent the use
     * of JS in `.svelte` files.
     */
    "allowJs": true,
    "checkJs": true,
    "isolatedModules": true,
    "moduleDetection": "force",

    /* Aliases */
    "baseUrl": ".",
    "paths": {
      "@/*": ["./app/frontend/*"],
      "/lib/*": ["./app/frontend/lib/*"],
      "/components/*": ["./app/frontend/components/*"],
      "/pages/*": ["./app/frontend/pages/*"],
      "/entrypoints/*": ["./app/frontend/entrypoints/*"],
      "/utils": ["./app/frontend/utils.ts"],
      "/routes/*": ["./app/frontend/routes/*"]
    }
  },

  "include": ["app/frontend/**/*.ts", "app/frontend/**/*.js", "app/frontend/**/*.svelte"],
  "exclude": ["app/frontend/routes/**/*"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
