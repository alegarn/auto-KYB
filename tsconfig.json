{
  "extends": "@tsconfig/svelte/tsconfig.json",
  "compilerOptions": {
    "target": "ESNext",
    "useDefineForClassFields": true,
    "module": "ESNext",
    "resolveJsonModule": true,
    "allowJs": true,
    "checkJs": true,
    "isolatedModules": true,
    "moduleDetection": "force",
    "baseUrl": ".",
    "types": ["node", "vitest", "@testing-library/jest-dom"],
    "paths": {
      "@/routes": ["./app/frontend/routes/*"],
      "@/*": ["./app/frontend/*"],
      "/lib/*": ["./app/frontend/lib/*"],
      "/components/*": ["./app/frontend/components/*"],
      "/pages/*": ["./app/frontend/pages/*"],
      "/entrypoints/*": ["./app/frontend/entrypoints/*"],
      "/utils": ["./app/frontend/utils.ts"],
      "/routes/*": ["./app/frontend/routes/*"]
    }
  },
  "include": [
    "app/frontend/**/*.ts",
    "app/frontend/**/*.js",
    "app/frontend/**/*.svelte",
    "test/frontend/**/*.ts",
    "test/frontend/**/*.svelte",
    "spec/frontend/**/*.ts",
    "spec/frontend/**/*.svelte",
    "vitest.shims.d.ts",
    "src/types",
    "stories/**/*.svelte"
  ],
  "exclude": ["app/frontend/routes/**/*"],
  "references": [{ "path": "./tsconfig.node.json" }]
}
