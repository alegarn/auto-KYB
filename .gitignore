# See https://help.github.com/articles/ignoring-files for more about ignoring files.

# Temporary files generated by your text editor or operating system
# belong in git's global ignore instead:
# $XDG_CONFIG_HOME/git/ignore or ~/.config/git/ignore

# Bundler
/.bundle
/vendor/bundle

# Environment files
/.env*
.env
.env*.local
*.local

# Logs and tempfiles (keep .keep files)
/log/*
/tmp
!/log/.keep
!/tmp/.keep

# Pids
/tmp/pids/*
!/tmp/pids/
!/tmp/pids/.keep

# Storage (uploaded files / sqlite)
/storage/*
!/storage/.keep
/tmp/storage/*
!/tmp/storage/
!/tmp/storage/.keep
/db/*.sqlite3
/db/*.sqlite3-journal
/db/*.sqlite3-[0-9]*

# Public assets / build outputs
/public/assets
/public/vite*
/public/packs
/public/packs-test
/public/system
/public/uploads

# Node / Vite / Yarn
node_modules/
yarn-debug.log*
yarn-error.log
.yarn-integrity

# Misc JS/Build
*.local

# Test / coverage / dev artifacts
*.rbc
capybara-*.html
.rspec
/coverage/
/spec/tmp
pickle-email-*.html
rerun.txt
*.orig

# Secrets / keys (do not commit)
config/initializers/secret_token.rb
config/master.key

# Misc environment / tooling
.rvmrc
.powenv
.byebug_history

# Bower (if used)
vendor/assets/bower_components
*.bowerrc
bower.json

# SvelteKit build output
/.svelte-kit
/build

.vscode/*
.roo/
.cache/

# Ignore automatically generated js-routes files.
/app/frontend/routes/index.js
/app/frontend/routes/index.d.ts


# Ignore storybook build outputs
/storybook-static/
/stories/assets/
*storybook.log

# Misc OS/editor artifacts
.DS_Store
Thumbs.db
*.swp

# IDEs
.idea/

# Ruby gems
*.gem

.github/agents